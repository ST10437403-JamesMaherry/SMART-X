{
  "Attachments": {
    "StoragePath": "App_Data/attachments"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "HttpsRedirection": {
    "Enabled": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Topology": {
    "Simulation": {
      "Enabled": false
    }
  }
}
