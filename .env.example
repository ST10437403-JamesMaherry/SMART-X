# Optional Docker Compose host port override.
#
# You do NOT need to create a .env file for normal Smart-X startup.
# Run: docker compose up -d --build
#
# The application has no third-party API credentials or cloud dependencies.
# A fresh local attachment encryption key is generated automatically inside
# the smartx-local-keys Docker volume and is reused on container recreation.
#
# If the default port 8080 is busy:
#   cp .env.example .env
#   # edit port below, then run docker compose up -d --build
#
# Compose binds the browser-facing service to 127.0.0.1 only.
SMARTX_HTTP_PORT=8080
