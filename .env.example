# =============================================================================
# SMART-X DOCKER COMPOSE CONFIGURATION
# =============================================================================
#
# Copy this file to .env before starting the Docker deployment:
#
#   cp .env.example .env
#
# The real .env file is ignored by Git and must never be committed.
#
# Generate a fresh 32-byte Base64 attachment-encryption key with:
#
#   openssl rand -base64 32
#
# Then place that value after SMARTX_ATTACHMENT_ENCRYPTION_KEY_BASE64= in
# your local .env file.
#
# Never reuse the deterministic test key from the automated test suite in a
# real Smart-X deployment.


# -----------------------------------------------------------------------------
# Browser-facing application port
# -----------------------------------------------------------------------------
#
# Nginx exposes the complete Smart-X application through this single host port.
# API requests and SignalR connections are reverse-proxied internally.
SMARTX_HTTP_PORT=8080


# -----------------------------------------------------------------------------
# Attachment encryption
# -----------------------------------------------------------------------------
#
# REQUIRED.
#
# Must contain a Base64-encoded 32-byte key used by the Smart-X AES-256-GCM
# attachment encryption pipeline.
#
# Leave this example value empty. A real key belongs only in the ignored
# .env file or another secure deployment secret store.
SMARTX_ATTACHMENT_ENCRYPTION_KEY_BASE64=
