# Git metadata is not required inside image build contexts.
.git

# Local editor configuration is not required by the containers.
.vscode
.idea

# Local secrets must never enter a Docker build context.
.env
**/.env

# .NET generated output.
**/bin
**/obj
artifacts

# Node/Vite generated output.
**/node_modules
**/dist

# Test and browser artefacts.
TestResults
**/test-results
**/playwright-report
**/blob-report

# Runtime encrypted attachment storage must never be copied into an image.
**/App_Data

# OS and IDE-specific files.
.DS_Store
*.user
*.suo
*.rsuser
